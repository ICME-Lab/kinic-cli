{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "kinic-portal",
  "main": "src/worker.tsx",
  "compatibility_date": "2026-04-15",
  "compatibility_flags": ["nodejs_compat"],
  "secrets": {
    "required": ["EMBEDDING_API_ENDPOINT"]
  },
  "kv_namespaces": [
    {
      "binding": "SUMMARY_CACHE",
      "id": "5ae0671d6e7c47fd9867184b609ae990",
      "preview_id": "3f14e59069344a389ab13828817f5b4f"
    }
  ],
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS"
  },
  "vars": {
    "IC_HOST": "https://ic0.app",
    "SUMMARY_CACHE_TTL_SECONDS": "86400",
    "KINIC_PORTAL_ORIGIN": "https://kinic-portal.kasane.workers.dev",
    "KINIC_PUBLIC_API_ORIGIN": "https://kinic-portal-public-api.kasane.workers.dev"
  }
}

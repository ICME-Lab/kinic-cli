{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "kinic-portal",
  "main": "src/worker.tsx",
  "compatibility_date": "2026-04-15",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  },
  "secrets": {
    "required": ["EMBEDDING_API_ENDPOINT"]
  },
  "kv_namespaces": [
    {
      "binding": "SUMMARY_CACHE",
      "id": "5ae0671d6e7c47fd9867184b609ae990",
      "preview_id": "3f14e59069344a389ab13828817f5b4f"
    }
  ],
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS"
  },
  "routes": [
    {
      "pattern": "memory.kinic.xyz",
      "custom_domain": true
    }
  ],
  "vars": {
    "IC_HOST": "https://ic0.app",
    "SUMMARY_CACHE_TTL_SECONDS": "86400",
    "KINIC_PORTAL_ORIGIN": "https://memory.kinic.xyz",
    "KINIC_PUBLIC_API_ORIGIN": "https://api.kinic.xyz",
    "KINIC_REMOTE_MCP_ORIGIN": "https://mcp.kinic.xyz"
  }
}

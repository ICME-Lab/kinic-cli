    "hono": "^4.10.1",
    "react": "^19.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260408.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.83.0"
  }
}
